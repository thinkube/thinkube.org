<!DOCTYPE html>
<html lang="{{or page.attributes.lang 'en'}}">
  <head>
{{> head}}
  </head>
  <body class="home">
{{> header}}
    <main class="home-main">

      <section class="hero">
        <p class="hero-eyebrow">Your hardware · your models · your data</p>
        <h1 class="hero-title">Sovereign AI<br> <span class="accent">starts at your desk</span></h1>
        <p class="hero-sub">Build AI apps on your own machines. Claude Code teams with you to do the work.
          Take it with you: it keeps running when the network changes.</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#playbooks">Start here</a>
          <a class="btn btn-ghost" href="start-here/what-is-thinkube.html">What Thinkube is</a>
        </div>

        <ol class="loop" aria-label="The Thinkube AI loop">
          <li class="loop-node"><span class="tk-icon loop-num" aria-hidden="true"></span><span class="loop-label">Get models</span></li>
          <li class="loop-node"><span class="tk-icon loop-num" aria-hidden="true"></span><span class="loop-label">Fine-tune</span></li>
          <li class="loop-node"><span class="tk-icon loop-num" aria-hidden="true"></span><span class="loop-label">Build apps</span></li>
          <li class="loop-node"><span class="tk-icon loop-num" aria-hidden="true"></span><span class="loop-label">Serve</span></li>
        </ol>
      </section>

      <section class="cockpit">
        <div class="cockpit-copy">
          <span class="kicker">How you work</span>
          <h2 class="section-h">Every task is a sentence to Claude</h2>
          <p class="cockpit-lead">Thinkube IDE comes with Claude Code, and Claude Code sees the platform:
            which models are loaded, what the GPU is holding, what a deploy is doing, what a service
            logged. Ask it to deploy a template or load a model and it calls the same operation the
            control panel's button calls. Nothing changes unless you ask. Every page on this site opens
            with the sentence you say.</p>
        </div>
        <div class="codewin" role="img"
             aria-label="A Claude Code session: deploy a template and load a model, driven by MCP tools.">
          <div class="codewin-bar">
            <span class="codewin-dots"><i></i><i></i><i></i></span>
            <span class="codewin-title">Thinkube IDE — claude</span>
          </div>
<pre class="codewin-body" aria-hidden="true"><code><span class="c-prompt">›</span> <span class="c-user">deploy the vLLM template and load Qwen3.5-4B</span>

<span class="c-claude">●</span> Deploying tkt-vllm-gradio.
  <span class="c-ok">✓</span> <span class="c-tool">deploy_template</span><span class="c-paren">(</span>tkt-vllm-gradio<span class="c-paren">)</span>       <span class="c-dim">→ pending</span>
  <span class="c-ok">✓</span> <span class="c-tool">get_deployment_status</span><span class="c-paren">(</span>…<span class="c-paren">)</span>              <span class="c-dim">→ building → running</span>

<span class="c-claude">●</span> Loading the model.
  <span class="c-ok">✓</span> <span class="c-tool">load_llm_model</span><span class="c-paren">(</span>Qwen/Qwen3.5-4B<span class="c-paren">)</span>         <span class="c-dim">→ loading · backend: vllm</span>
  <span class="c-ok">✓</span> <span class="c-tool">get_llm_model_status</span><span class="c-paren">(</span>…<span class="c-paren">)</span>               <span class="c-dim">→ available</span>

  Your app is at <span class="c-link">vllm.thinkube.com</span></code></pre>
        </div>
      </section>

      <section class="journeys">
        <h2 class="section-h">Four areas, one platform</h2>
        <div class="card-grid">
          <a class="card area-kubernetes" href="kubernetes/index.html">
            <span class="card-head"><span class="tk-icon tk-area-icon" aria-hidden="true"></span><h3 class="card-title">The base, ready and signed in</h3></span>
            <p class="card-desc">Unmodified upstream Kubernetes on your machines, with identity, storage, registry, database and GPUs ready, driven from Claude Code.</p>
            <span class="card-badges"><span class="badge badge-area">Thinkube Kubernetes</span></span>
          </a>
          <a class="card area-gitops" href="apps/index.html">
            <span class="card-head"><span class="tk-icon tk-area-icon" aria-hidden="true"></span><h3 class="card-title">Push to git, and it runs</h3></span>
            <p class="card-desc">From a template to an application at its own address behind your login, and every change after that a push.</p>
            <span class="card-badges"><span class="badge badge-area">Thinkube GitOps</span></span>
          </a>
          <a class="card area-models" href="lifecycle/index.html">
            <span class="card-head"><span class="tk-icon tk-area-icon" aria-hidden="true"></span><h3 class="card-title">Serve, fine-tune, track</h3></span>
            <p class="card-desc">Open models on your own GPUs, from a notebook to one address every app calls.</p>
            <span class="card-badges"><span class="badge badge-area">Thinkube Models</span></span>
          </a>
          <a class="card area-tandem" href="tandem/index.html">
            <span class="card-head"><span class="tk-icon tk-area-icon" aria-hidden="true"></span><h3 class="card-title">A sentence to a running change</h3></span>
            <p class="card-desc">Say what you want; it is built under checks, deployed and judged on the running product, and you decide.</p>
            <span class="card-badges"><span class="badge badge-area">Thinkube Tandem</span></span>
          </a>
        </div>
      </section>

{{#with (playbooks featured=true)}}
{{#if length}}
      <section class="journeys catalog" id="first-time">
        <span class="kicker">Playbooks</span>
        <h2 class="section-h">First time here?</h2>
        <div class="card-grid playbook-grid featured-grid">
{{#each this}}
{{> playbook-card}}
{{/each}}
        </div>
      </section>
{{/if}}
{{/with}}

      <section class="journeys catalog" id="playbooks">
        <h2 class="section-h">All playbooks</h2>
        <div class="area-filter" role="group" aria-label="Show playbooks of one area">
          <button type="button" class="filter-chip is-active" data-filter="all" aria-pressed="true">All</button>
          <button type="button" class="filter-chip area-kubernetes" data-filter="kubernetes" aria-pressed="false">Thinkube Kubernetes</button>
          <button type="button" class="filter-chip area-gitops" data-filter="gitops" aria-pressed="false">Thinkube GitOps</button>
          <button type="button" class="filter-chip area-models" data-filter="models" aria-pressed="false">Thinkube Models</button>
          <button type="button" class="filter-chip area-tandem" data-filter="tandem" aria-pressed="false">Thinkube Tandem</button>
        </div>
        <div class="card-grid playbook-grid" id="playbook-grid">
{{#each (playbooks)}}
{{> playbook-card}}
{{/each}}
        </div>
      </section>

    </main>
{{> footer}}
  </body>
</html>
