<article class="doc{{#with page.attributes.type}} doc--{{this}}{{/with}}{{#with page.attributes.area}} area-{{this}}{{/with}}">
{{#if (eq page.attributes.type 'playbook')}}
<header class="playbook-head">
  <p class="playbook-kicker">{{area-name page.attributes.area}}</p>
{{#with page.title}}
  <h1 class="page">{{{this}}}</h1>
{{/with}}
  <p class="playbook-tagline">{{page.attributes.tagline}}</p>
  <dl class="playbook-facts">
    <div><dt>Level</dt><dd class="cap">{{page.attributes.difficulty}}</dd></div>
    <div><dt>Time</dt><dd title="Measured on the reference cluster">{{page.attributes.time}}{{#with page.attributes.time-note}}<span class="facts-note">, {{this}}</span>{{/with}}</dd></div>
    <div><dt>Risk</dt><dd class="cap">{{page.attributes.risk}}</dd></div>
    <div><dt>Updated</dt><dd>{{page.attributes.updated}}</dd></div>
  </dl>
  <p class="playbook-tags">{{#each (split page.attributes.tags)}}<span class="tag">{{this}}</span>{{/each}}</p>
</header>
{{else if (eq page.attributes.type 'reference')}}
<p class="playbook-kicker">Reference</p>
{{else}}
<p class="playbook-kicker">Learn</p>
{{#with page.title}}
<h1 class="page">{{{this}}}</h1>
{{/with}}
{{/if}}
{{#if (eq page.layout 'area')}}
{{#with (area-split page.contents)}}
{{{before}}}
<section class="catalog area-catalog" id="playbooks">
  <h2>Playbooks</h2>
  <div class="card-grid playbook-grid">
{{#each (playbooks area=../page.attributes.area)}}
{{> playbook-card}}
{{/each}}
  </div>
</section>
{{{after}}}
{{/with}}
{{else}}
{{{page.contents}}}
{{/if}}
{{> pagination}}
</article>
