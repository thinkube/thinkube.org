<a class="card playbook-card area-{{area}}" data-area="{{area}}" href="{{{relativize url}}}">
  <span class="card-edge card-edge-area">{{area-name area}}</span>
  <span class="card-edge card-edge-time">{{time}}</span>
  <span class="card-head"><span class="tk-icon tk-area-icon" aria-hidden="true"></span><span class="card-id"><h3 class="card-title">{{{title}}}</h3><span class="card-level">{{difficulty}}</span></span></span>
  <p class="card-desc">{{tagline}}</p>
  <span class="card-edge card-edge-updated">{{updated}}</span>
</a>
